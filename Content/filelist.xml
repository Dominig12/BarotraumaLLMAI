<?xml version="1.0" encoding="utf-8"?>
<!--
  The AI itself is a server-side plugin (LuaCsForBarotrauma with C# enabled, on the server only).
  The content below (the "Full AI control" order, its icon and texts) is downloaded by clients automatically
  when they join, so the order shows up in their command menu. Clients do not need LuaCs.
-->
<contentpackage name="LlmAgents" modversion="0.5.0" corepackage="false">
  <Orders file="%ModDir%/Orders.xml" />
  <Text file="%ModDir%/Texts/English.xml" />
  <Text file="%ModDir%/Texts/Russian.xml" />
</contentpackage>
